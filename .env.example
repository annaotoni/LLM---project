# Conexão com o banco de dados PostgreSQL com suporte a pgvector.
# Para dev fora do Docker: substitua "postgres" por "localhost".
# Para Docker (docker compose up): use "postgres" como host.
DATABASE_URL=postgresql://copiloto:copiloto@postgres:5432/copiloto

# Provider do modelo de linguagem.
# Opções: "ollama" (local, padrão), "openai", "anthropic" e outros suportados pelo litellm.
LLM_PROVIDER=ollama

# Identificador do modelo no formato litellm (<provider>/<nome>).
# Ollama: "ollama/qwen2.5:3b" | OpenAI: "openai/gpt-4o" | Anthropic: "anthropic/claude-3-5-haiku-20241022"
LLM_MODEL=ollama/qwen2.5:3b

# Modelo de embedding — deve produzir vetores de 384 dimensões (dimensão definida no schema.sql).
# Ollama: "ollama/all-minilm" | OpenAI: "openai/text-embedding-3-small"
LLM_EMBEDDING_MODEL=ollama/all-minilm

# URL base do Ollama. Ignorado quando LLM_PROVIDER != "ollama".
# Para dev fora do Docker: "http://localhost:11434".
# Para Docker: "http://ollama:11434".
OLLAMA_BASE_URL=http://ollama:11434

# Número de documentos recuperados por busca RAG.
RAG_TOP_K=5
