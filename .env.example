# Banco de dados (usado pelo container "postgres" no docker-compose)
POSTGRES_USER=copiloto
POSTGRES_PASSWORD=copiloto
POSTGRES_DB=copiloto

# String de conexão usada pela aplicação.
# Dentro do docker-compose o host é o nome do serviço ("postgres").
# Rodando a app fora do Docker (ex.: pytest local), troque o host para "localhost".
DATABASE_URL=postgresql://copiloto:copiloto@postgres:5432/copiloto

# LLM — provider padrão é Ollama local, sem custo e sem chave de API.
# "ollama_chat/" (não "ollama/") é o prefixo exigido pelo LiteLLM para suportar tool calling.
LLM_PROVIDER=ollama
LLM_MODEL=ollama_chat/qwen2.5:3b
LLM_EMBEDDING_MODEL=ollama/all-minilm
OLLAMA_BASE_URL=http://ollama:11434
RAG_TOP_K=4
